# Used by docker-compose.yml. Generate each with: openssl rand -hex 32
# Admin key for the dashboard and /api/*.
API_KEY=
# Encrypts VPS passwords/keys and registry tokens at rest. Don't change it after adding servers.
SECRET_KEY=

# Images to run. Replace <owner>/<repo> with your GitHub repository (lowercase).
BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend:latest
FRONTEND_IMAGE=ghcr.io/<owner>/<repo>-frontend:latest

# Postgres database, e.g. Neon. When empty, data is stored in SQLite in the vps-studio-data volume.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional
# FRONTEND_PORT=3100
# STARTUP_GRACE_SECONDS=5
