# Used by `go run ./cmd/server` (local development). Copy to .env in this folder.
# Admin key for /api/* — send as "Authorization: Bearer <API_KEY>". Generate: openssl rand -hex 32
API_KEY=
# Encrypts VPS passwords/keys and registry tokens at rest. Don't change it later or saved secrets
# become unreadable. Generate: openssl rand -hex 32
SECRET_KEY=

# Postgres database, e.g. Neon: postgresql://user:password@host/db?sslmode=require
# When empty, data is stored in the SQLite file at DATABASE_PATH.
# DATABASE_URL=

# Optional
# PORT=8081
# DATABASE_PATH=data/vps-studio.db
# DOCKER_NETWORK=vps-studio
# STARTUP_GRACE_SECONDS=5
